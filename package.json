{
  "name": "starforge",
  "private": true,
  "version": "1.5.0",
  "description": "Starforge: a space-fantasy incremental game",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "vite build && playwright test",
    "sim": "vitest run --config vitest.sim.config.ts --reporter=verbose --silent=false",
    "tauri": "tauri",
    "budgets": "node scripts/budgets.mjs",
    "single": "vite build --config scripts/single/single.config.ts && node scripts/single/inline.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "break_eternity.js": "2.1.3",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
