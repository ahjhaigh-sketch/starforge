{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starforge",
  "version": "1.1.0",
  "identifier": "io.github.ahjhaigh-sketch.starforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starforge",
        "width": 1400,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ahjhaigh-sketch",
    "copyright": "Starforge by ahjhaigh-sketch",
    "shortDescription": "A space-fantasy incremental game",
    "longDescription": "Tap a dying star back to life, then forge it through six reset layers: Supernova, Nebula, Singularity, Galactic Rebirth, the Big Crunch and the Multiverse.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
